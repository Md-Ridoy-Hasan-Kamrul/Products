---
import NotFound from '../../components/layout/NotFound.astro';
import ProductGrid from '../../components/products/ProductGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCatalog } from '../../lib/api';
import { CATEGORIES } from '../../lib/categories';

// Rendered per request so new products show up at once.
export const prerender = false;

const category = CATEGORIES.find((c) => c.slug === Astro.params.slug);
if (!category) Astro.response.status = 404;
const { products } = category ? await loadCatalog({ category: category.slug }) : { products: [] };
const Icon = category?.icon;
---

{!category || !Icon ? <NotFound /> : (

<BaseLayout title={`${category.name} — Your Products Your Dreams`} description={`Shop ${category.name} from local sellers.`}>
	<div class="container-page pt-6">
		<div class="flex items-center gap-4 rounded-2xl bg-surface p-6">
			<span class="grid size-14 place-items-center rounded-full bg-brand-soft text-brand" aria-hidden="true">
				<Icon className="size-7" strokeWidth={1.5} />
			</span>
			<div>
				<h1 class="m-0 text-2xl font-black">{category.name}</h1>
				<p class="m-0 text-sm text-ink-soft">
					{products.length} {products.length === 1 ? 'product' : 'products'}
				</p>
			</div>
		</div>
		<div class="mt-6">
			{
				products.length > 0 ? (
					<ProductGrid products={products} />
				) : (
					<p class="rounded-xl bg-surface p-10 text-center text-ink-soft">
						No products in this category yet. <a href="/" class="font-semibold text-brand">Browse everything</a>
					</p>
				)
			}
		</div>
	</div>
</BaseLayout>
)}
