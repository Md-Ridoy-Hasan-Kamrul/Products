---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — Your Products Your Dreams" noindex>
	<div class="container-page pt-6">
		<div class="rounded-2xl bg-surface p-10 text-center">
			<h1 class="m-0 text-2xl font-black">This page is not available</h1>
			<p class="m-0 mt-2 text-ink-soft">The product may have been removed, or the shop is not open right now.</p>
			<a href="/" class="mt-6 inline-block rounded-lg bg-brand px-5 py-2.5 font-semibold text-white no-underline hover:bg-brand-deep">
				Browse the shop
			</a>
		</div>
	</div>
</BaseLayout>
