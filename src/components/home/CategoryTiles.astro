---
import { CATEGORIES, categoryPath } from '../../lib/categories';
---

<section class="container-page mt-10" aria-labelledby="categories-title">
	<h2 id="categories-title" class="m-0 mb-4 text-xl font-bold">Shop by category</h2>
	<ul class="m-0 grid list-none grid-cols-4 gap-3 p-0 min-[960px]:grid-cols-8">
		{
			CATEGORIES.map((category) => (
				<li>
					<a
						href={categoryPath(category.slug)}
						class="flex h-full flex-col items-center gap-2 rounded-xl bg-surface p-3 text-center text-xs font-medium text-ink no-underline transition-transform hover:-translate-y-0.5 hover:text-brand min-[720px]:text-sm"
					>
						<span
							class="grid size-12 place-items-center rounded-full text-2xl min-[720px]:size-14"
							style={`background-color: ${category.tint}`}
							aria-hidden="true"
						>
							{category.icon}
						</span>
						{category.name}
					</a>
				</li>
			))
		}
	</ul>
</section>
