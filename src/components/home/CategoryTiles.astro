---
import { CATEGORIES, categoryPath } from '../../lib/categories';
---

<section class="container-page mt-10" aria-labelledby="categories-title">
	<h2 id="categories-title" class="m-0 mb-4 text-xl font-bold">Shop by category</h2>
	<ul class="m-0 grid list-none grid-cols-4 gap-3 p-0 min-[960px]:grid-cols-8">
		{
			CATEGORIES.map(({ slug, name, icon: Icon }) => (
				<li>
					<a
						href={categoryPath(slug)}
						class="group flex h-full flex-col items-center gap-2.5 rounded-xl border border-transparent bg-surface p-4 text-center text-xs font-medium text-ink no-underline transition-colors hover:border-brand/30 hover:text-brand min-[720px]:text-sm"
					>
						<span
							class="grid size-12 place-items-center rounded-full bg-brand-soft text-brand transition-colors group-hover:bg-brand group-hover:text-white"
							aria-hidden="true"
						>
							<Icon className="size-6" strokeWidth={1.5} />
						</span>
						{name}
					</a>
				</li>
			))
		}
	</ul>
</section>
