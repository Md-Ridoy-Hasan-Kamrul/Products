---
import AppLayout from './AppLayout.astro';

interface Props {
	title: string;
	heading: string;
	subheading: string;
}

const { title, heading, subheading } = Astro.props;
---

<AppLayout title={title}>
	<div class="flex min-h-screen flex-col bg-canvas">
		<header class="container-page flex h-16 items-center justify-between">
			<a href="/" class="flex items-center gap-2 text-ink no-underline">
				<span class="grid size-8 place-items-center rounded-lg bg-brand text-sm font-black text-white" aria-hidden="true">Y</span>
				<span class="text-sm font-bold">Your Products Your Dreams</span>
			</a>
			<a href="/" class="text-sm font-medium text-ink-soft no-underline hover:text-ink">Back to store</a>
		</header>
		<main id="main" class="grid flex-1 place-items-center px-4 pb-16">
			<div class="w-full max-w-md">
				<div class="mb-6 text-center">
					<h1 class="m-0 text-2xl font-bold tracking-tight">{heading}</h1>
					<p class="m-0 mt-1 text-sm text-ink-soft">{subheading}</p>
				</div>
				<div class="rounded-xl border border-line bg-surface p-6 shadow-xs min-[480px]:p-8">
					<slot />
				</div>
			</div>
		</main>
	</div>
</AppLayout>
