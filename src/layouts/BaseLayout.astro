---
import Footer from '../components/layout/Footer.astro';
import Head from '../components/layout/Head.astro';
import Header from '../components/layout/Header.astro';
import ScrollRestore from '../components/layout/ScrollRestore.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = 'Your Products Your Dreams',
	description = 'Shop from trusted local sellers and order straight on WhatsApp.',
	noindex = false,
} = Astro.props;
---

<!doctype html>
<!--
	[scrollbar-gutter:stable]: short pages (a small category) keep the scrollbar's
	space, so they do not shift sideways against long ones (home).
	motion-safe:focus-within:scroll-smooth: smooth only for in-page links (they
	have focus), never for Back/Forward scroll restoration.
-->
<html lang="en" class="[scrollbar-gutter:stable] motion-safe:focus-within:scroll-smooth">
	<head>
		<Head title={title} description={description} noindex={noindex} />
		<ScrollRestore part="head" />
	</head>
	<body class="flex min-h-screen flex-col font-body text-base leading-body text-ink bg-canvas [&_:disabled]:cursor-not-allowed">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-brand focus:px-3 focus:py-2 focus:text-white"
		>
			Skip to content
		</a>
		<Header />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer />
		<ScrollRestore part="end" />
	</body>
</html>
