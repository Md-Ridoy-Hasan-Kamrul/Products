NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:4321
# Base URL of this API, used for auth and mock image URLs
PUBLIC_URL=http://localhost:4000

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Admin account created at startup
ADMIN_EMAIL=admin@ypyd.local
ADMIN_PASSWORD=admin12345

# mock | cloudinary
IMAGE_PROVIDER=mock
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# auto: a new shop is live at once | manual: an admin approves it first
VENDOR_APPROVAL=auto
